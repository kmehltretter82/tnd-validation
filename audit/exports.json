  "descriptions": {
    "TNDLib.Algebra.product": "Folds a list with an explicitly supplied binary operation and identity element.",
    "TNDLib.Algebra.productAppend": "Shows that list product preserves append when the operation is associative and has a left identity.",
    "TNDLib.Algebra.productCons": "Unfolds the product of a nonempty list at its leading element.",
    "TNDLib.Algebra.productNil": "Identifies the product of the empty list with the supplied identity.",
    "TNDLib.Algebra.productSingleton": "Identifies a singleton product with its element when the identity is right unital.",
    "TNDLib.Finite.enumerate": "Constructively lists every inhabitant of the explicitly bounded type Fin n.",
    "TNDLib.Finite.lengthEnumerate": "Shows that the explicit enumeration of Fin n contains exactly n entries.",
    "TNDLib.Finite.memEnumerate": "Shows that every bounded index occurs in the explicit enumeration of Fin n.",
    "TNDLib.Finite.memSelect": "Characterizes membership in a finite filter by the supplied decidable predicate.",
    "TNDLib.Finite.select": "Filters an explicit finite enumeration using a supplied decision procedure.",
    "TNDLib.List.splitAt": "Returns a prefix and suffix together with recombination and prefix-length evidence.",
    "TNDLib.List.splitAtLength": "Extracts the certified upper bound on the returned prefix length.",
    "TNDLib.List.splitAtPrefix": "Identifies the certified split's first component with List.take.",
    "TNDLib.List.splitAtRecombine": "Shows that concatenating the certified prefix and suffix recovers the input list.",
    "TNDLib.List.splitAtSuffix": "Identifies the certified split's second component with List.drop.",
    "TNDLib.Logic.andOrDistribute": "Distributes conjunction over disjunction without deciding either proposition.",
    "TNDLib.Logic.decidableDoubleNegation": "Eliminates double negation when an explicit decision procedure for the proposition is available.",
    "TNDLib.Logic.decidableExcludedMiddle": "Derives excluded middle for a proposition from its explicit Decidable instance.",
    "TNDLib.Logic.doubleNegatedExcludedMiddle": "Proves the double negation of excluded middle without assuming a decision procedure.",
    "TNDLib.Logic.notOr": "Proves the constructive De Morgan equivalence between not-or and a pair of negations.",
    "TNDLib.Nat.leSumTo": "Shows that the triangular sum through n is at least n.",
    "TNDLib.Nat.sumTo": "Computes the sum of the natural numbers from one through the input.",
    "TNDLib.Nat.sumToSucc": "Exposes the recursive successor equation for the triangular sum.",
    "TNDLib.Nat.sumToWitness": "Returns a triangular sum together with equality and lower-bound evidence.",
    "TNDLib.Predicate.assembleWitnesses": "Builds a function and its pointwise specification from explicitly supplied witness data.",
    "TNDLib.Predicate.existsOr": "Distributes an existential quantifier over disjunction constructively.",
    "TNDLib.Predicate.forallAnd": "Shows that universal quantification preserves conjunction.",
    "TNDLib.Predicate.notExists": "Equates negation of an existential with pointwise negation constructively."
  },
